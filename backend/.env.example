# Security
JWT_SECRET=dev_secret_key_change_me_please_123456
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Biometric login (WebAuthn / passkeys)
# RP ID must be the site's registered domain (no scheme, no port). Passkeys are
# permanently bound to it, so pin the real domain before shipping.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Familia
# Comma-separated list of full origins the frontend is served from.
WEBAUTHN_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgres://familia_app:strongpassword@db:5432/familia

# Admin roles (comma-separated phone numbers)
ADMIN_PHONES=0537002171,0523767851

# App
PORT=3001

# Distributed rate limiting (Railway Redis)
REDIS_URL=
RATE_LIMIT_PREFIX=familia:ratelimit
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_WINDOW_SEC=60
RATE_LIMIT_OTP_REQUEST_PHONE_LIMIT=3
RATE_LIMIT_OTP_REQUEST_PHONE_WINDOW_SEC=600
RATE_LIMIT_OTP_REQUEST_IP_LIMIT=10
RATE_LIMIT_OTP_REQUEST_IP_WINDOW_SEC=600
RATE_LIMIT_OTP_VERIFY_PHONE_LIMIT=10
RATE_LIMIT_OTP_VERIFY_PHONE_WINDOW_SEC=600
RATE_LIMIT_OTP_VERIFY_IP_LIMIT=30
RATE_LIMIT_OTP_VERIFY_IP_WINDOW_SEC=600
RATE_LIMIT_OTP_VERIFY_FAILED_THRESHOLD=10
RATE_LIMIT_OTP_VERIFY_FAILED_LOCK_SEC=600
RATE_LIMIT_AVAILABILITY_IP_LIMIT=60
RATE_LIMIT_AVAILABILITY_IP_WINDOW_SEC=60
RATE_LIMIT_AVAILABILITY_PHONE_LIMIT=120
RATE_LIMIT_AVAILABILITY_PHONE_WINDOW_SEC=300
RATE_LIMIT_BOOKING_PHONE_BURST_LIMIT=3
RATE_LIMIT_BOOKING_PHONE_BURST_WINDOW_SEC=300
RATE_LIMIT_BOOKING_PHONE_DAILY_LIMIT=5
RATE_LIMIT_BOOKING_PHONE_DAILY_WINDOW_SEC=86400
RATE_LIMIT_BOOKING_IP_DAILY_LIMIT=20
RATE_LIMIT_BOOKING_IP_DAILY_WINDOW_SEC=86400
RATE_LIMIT_ADMIN_VERIFY_IP_LIMIT=20
RATE_LIMIT_ADMIN_VERIFY_IP_WINDOW_SEC=3600
RATE_LIMIT_ADMIN_VERIFY_FAILED_THRESHOLD=10
RATE_LIMIT_ADMIN_VERIFY_FAILED_LOCK_SEC=300
