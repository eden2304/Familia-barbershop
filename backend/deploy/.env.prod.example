# Core runtime
NODE_ENV=production
PORT=3001

# WhatsApp Cloud API
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_AUTH_TEMPLATE_NAME=verification_code
WHATSAPP_AUTH_TEMPLATE_LANG=he
# Allowed: body_only | button_only | body_and_button
# - body_only: template has only {{1}} in body
# - button_only: template has only copy_code button placeholder
# - body_and_button: template expects both body {{1}} and copy_code button
WHATSAPP_AUTH_TEMPLATE_MODE=body_and_button

# Optional button parameter field mapping for copy_code component
# Allowed: text | coupon_code | payload
WHATSAPP_AUTH_BUTTON_PARAM_TYPE=text
